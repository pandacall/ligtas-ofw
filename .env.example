# Postgres connection string for @ligtas-ofw/db (drizzle-kit migrate/push, packages/db/src/seed.ts).
# Production uses a provisioned Neon instance (issue #12) — this is just the local/dev template; put your own Postgres URL here.
DATABASE_URL=

# Disposable test Postgres for packages/sync's integration tests: `docker compose up -d --wait`,
# then this matches docker-compose.yml's throwaway credentials/port. Required in CI; if unset
# locally, the integration test skips (see packages/sync/src/promote.test.ts).
TEST_DATABASE_URL=postgres://ligtas_test:ligtas_test@localhost:55432/ligtas_ofw_test

# Static DMW API key for packages/sync (nightly registry pull) — see packages/sync/DATA-SOURCES.md.
DMW_API_KEY=

# Extraction provider credentials for the job-post scan (ADR-0002/0003).
EXTRACTOR_API_KEY=

# OpenAI-compatible model id and base URL for the Extractor — env config, never a code change.
# Default v1 (free-tier, vision-capable): google/gemma-4-26b-a4b-it:free on OpenRouter
# (ADR-0004 — chosen over gemma-4-31b-it:free for having 2 backing providers, not just 1).
EXTRACTOR_MODEL=google/gemma-4-26b-a4b-it:free
EXTRACTOR_BASE_URL=https://openrouter.ai/api/v1

# Quota protection (issue #11) — a config-driven global daily scan budget and a per-IP
# sliding-window rate limit, both backed by Postgres (packages/core/src/quota.ts). Once
# SCAN_DAILY_BUDGET scans have run today (UTC), every scan degrades to Quota Exhausted;
# once one IP hits SCAN_RATE_LIMIT_MAX scans within SCAN_RATE_LIMIT_WINDOW_MINUTES, that
# IP alone is Rate Limited. All three have defaults (below) — set to override.
SCAN_DAILY_BUDGET=50
SCAN_RATE_LIMIT_MAX=5
SCAN_RATE_LIMIT_WINDOW_MINUTES=10

# Chat routing budget (ADR-0005) — metered separately from the scan budget above, against the
# same event log via its `kind` column. A routing call is text-only and far cheaper than a
# vision extraction, so it gets a much larger allowance; and exhausting one budget must never
# disable the other. Most chat turns spend nothing at all — the deterministic pre-router
# resolves quick actions, screenshots, pasted posts, and keyword-matched questions with zero
# LLM calls. When this budget is spent, turns degrade to Router Unavailable and those
# zero-LLM paths keep working. Set CHAT_DAILY_BUDGET=0 to verify that degradation locally.
CHAT_DAILY_BUDGET=500
CHAT_RATE_LIMIT_MAX=30
CHAT_RATE_LIMIT_WINDOW_MINUTES=10

# The Router model (ADR-0005). Defaults to the Extractor's credentials, endpoint, and model
# when unset, so a single OpenRouter key covers both roles.
# CHAT_API_KEY=
# CHAT_MODEL=google/gemma-4-26b-a4b-it:free
# CHAT_BASE_URL=https://openrouter.ai/api/v1
